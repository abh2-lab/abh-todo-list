DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google login. Make it in Google Cloud: Credentials > OAuth client ID > Web application.
# Allowed redirect URLs: https://your-site/auth/google and http://localhost:3000/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Secret that locks the login cookie: at least 32 random characters.
# `npm run dev` makes one for you; the live site needs its own (keep it the same between restarts).
NUXT_SESSION_PASSWORD=

# Only needed if Google says "redirect_uri_mismatch" on the live site (for example behind a proxy):
# NUXT_OAUTH_GOOGLE_REDIRECT_URL=https://your-site/auth/google
